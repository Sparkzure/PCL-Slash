<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    mc:Ignorable="d" x:Class="PageSetupLauncher"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15,0,15" Title="启动器">
                <Grid Margin="25,40,25,20" Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="启动器更新" Margin="0,0,25,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <local:MyButton x:Name="BtnSystemUpdate" MinWidth="140" Height="28" Text="查看更新" Padding="13,0" Margin="0,0,20,0" />
                        <local:MyCheckBox x:Name="CheckLauncherUpdateNotify" Text="启动时检查新版" VerticalAlignment="Center" local:SettingService.Key="SystemLauncherUpdateNotify"
                                          ToolTip="启动时检查 GitHub Releases 中已发布的版本，在左下角显示检查结果，发现新版时弹窗通知。同一版本仅通知一次。" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="更新检查源" Margin="0,0,25,0" />
                    <local:MyComboBox x:Name="ComboLauncherUpdateSource" Height="28" Grid.Row="2" Grid.Column="1" local:SettingService.Key="SystemLauncherUpdateSource">
                        <local:MyComboBoxItem Content="GitHub 官方（默认）" />
                        <local:MyComboBoxItem Content="GH-Proxy 镜像" />
                        <local:MyComboBoxItem Content="自定义源" />
                    </local:MyComboBox>
                    <Grid x:Name="PanLauncherUpdateCustomSource" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,9,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="自定义源" Margin="0,0,25,0" />
                        <local:MyTextBox x:Name="TextLauncherUpdateCustomSource" Grid.Column="1" local:SettingService.Key="SystemLauncherUpdateCustomSource"
                                         HintText="https://exmple.com/repos/sparkzure/PCL-Slash/releases?per_page=100"
                                         ToolTip="填写完整的更新检查链接，例如 https://exmple.com/repos/sparkzure/PCL-Slash/releases?per_page=100。&#xa;前缀代理示例：https://exmple.com/https://api.github.com/repos/sparkzure/PCL-Slash/releases?per_page=100。&#xa;链接须返回 GitHub Releases 格式的 JSON，所选源仅用于检查启动器更新。" />
                    </Grid>
                    <TextBlock Grid.Row="5" VerticalAlignment="Center" HorizontalAlignment="Left" Text="缓存文件夹" Margin="0,0,25,0" />
                    <local:MyTextBox x:Name="TextSystemCache" IsEnabled="False" Grid.Row="5" Grid.ColumnSpan="2" local:SettingService.Key="SystemSystemCache" Grid.Column="1" ToolTip="便携模式固定保存在启动器所在文件夹的 PCL\Temp 中。" HintText="PCL\Temp（便携模式）">
                        <local:MyTextBox.ValidateRules>
                            <local:ValidateNullable />
                            <local:ValidateFolderPath UseMinecraftCharCheck="False" />
                        </local:MyTextBox.ValidateRules>
                    </local:MyTextBox>
                    <Grid Height="35" Grid.Row="6" Grid.ColumnSpan="5" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <!-- 配置 ZIP 支持范围提示。 -->
                        <local:MyButton Grid.Column="0" x:Name="BtnSystemSettingExp" MinWidth="140" Text="导出设置" Padding="13,0" Margin="0,0,20,0" ToolTip="导出普通设置、外观资源和实例整合包；不包含 Java 路径、游戏本体、libraries、assets、Java 或加密配置。" />
                        <local:MyButton Grid.Column="1" x:Name="BtnSystemSettingImp" MinWidth="140" Text="导入设置" Padding="13,0" Margin="0,0,20,0" ToolTip="恢复配置和实例整合包，保留本机账号及 Java 选择；实例恢复到新目录，重新打开启动器后联网补全运行组件。" />

                        <local:MyButton Grid.Column="2" x:Name="BtnSystemPcl2Migration" MinWidth="140" Text="PCL2 迁入" Padding="13,0" ToolTip="只读复制 PCL2 的设置与游戏实例到 PCL-Slash。迁入前请关闭 PCL2，并确保两个启动器位于独立目录且空间充足。" />
                    </Grid>
                </Grid>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
