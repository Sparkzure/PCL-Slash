<local:MyPageRight x:Class="PageOtherTileMatch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL">
    <local:MyPageRight.Resources>
        <Style x:Key="TileMatchCellStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush1}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Margin="2" CornerRadius="4" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Border BorderBrush="#40000000" BorderThickness="1" CornerRadius="3" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:MyPageRight.Resources>
    <Grid Margin="25,10">
        <local:MyCard x:Name="CardTileMatch" Title="连连看" Margin="0,15">
            <Grid Margin="25,40,25,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,12">
                    <local:MyButton x:Name="BtnTileMatchRestart" Text="重新开始" Height="30" Padding="14,0" Margin="0,0,18,8" />
                    <TextBlock x:Name="LabTileMatchRound" VerticalAlignment="Center" Margin="0,0,18,8" Foreground="{DynamicResource ColorBrush1}" />
                    <TextBlock x:Name="LabTileMatchRemaining" VerticalAlignment="Center" Margin="0,0,18,8" Foreground="{DynamicResource ColorBrush1}" />
                    <TextBlock x:Name="LabTileMatchTime" VerticalAlignment="Center" Margin="0,0,0,8" Foreground="{DynamicResource ColorBrush1}" />
                </WrapPanel>
                <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly">
                    <Border Background="{DynamicResource ColorBrushGray8}" BorderBrush="{DynamicResource ColorBrushGray5}"
                            BorderThickness="1" CornerRadius="4" Padding="4">
                        <UniformGrid x:Name="PanTileMatchBoard" Rows="10" Columns="10" Width="360" Height="360" AutomationProperties.Name="连连看棋盘" />
                    </Border>
                </Viewbox>
            </Grid>
        </local:MyCard>
    </Grid>
</local:MyPageRight>
