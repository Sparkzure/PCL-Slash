<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageOtherAbout"
    PanScroll="PanBack" RenderOptions.BitmapScalingMode="LowQuality">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10" Grid.IsSharedSizeScope="True">
            <local:MyCard Margin="0,15" Title="关于">
                <Grid Margin="21,40,21,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45" />
                        <RowDefinition Height="45" />
                        <RowDefinition Height="45" />
                        <RowDefinition Height="45" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <local:MyListItem x:Name="ItemAboutLecyn" IsHitTestVisible="False" Title="Lecyn" Margin="-5,0,15,0" Info="Plain Craft Launcher Slash 的开发者" Grid.Row="1" Grid.Column="1" />
                    <local:MyListItem IsHitTestVisible="False" Title="龙腾猫跃" Margin="-5,0,15,0" Info="原版 Plain Craft Launcher 的开发者" Grid.Row="0" Grid.Column="1" />
                    <local:MyListItem IsHitTestVisible="False" Title="HerobrineXia" Margin="-5,0,15,0" Info="原版 Plain Craft Launcher 的协力开发者" Grid.Row="2" Grid.Column="1" />
                    <local:MyListItem IsHitTestVisible="False" Title="{x:Static local:ModBase.BrandFullName}" Margin="-5,0,15,0" Info="独立分支 · 基于 Plain Craft Launcher · 当前版本：%VERSION%（%VERSIONCODE%.%BRANCH%）" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ItemAboutPcl" />
                    <Image x:Name="ImageAboutLecyn" Source="/Plain Craft Launcher Slash;component/Images/Heads/Lecyn.jpg" Grid.Row="1" Width="34" Height="34" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Clip><EllipseGeometry Center="17 17" RadiusX="17" RadiusY="17" /></Image.Clip>
                    </Image>
                    <Image Source="/Plain Craft Launcher Slash;component/Images/Heads/LTCat.jpg" Grid.Row="0" Margin="3">
                        <Image.Clip><EllipseGeometry Center="17 17" RadiusX="17" RadiusY="17" /></Image.Clip>
                    </Image>
                    <Image Source="/Plain Craft Launcher Slash;component/Images/Heads/HerobrineXia.png" Grid.Row="2" Margin="3">
                        <Image.Clip><EllipseGeometry Center="17 17" RadiusX="17" RadiusY="17" /></Image.Clip>
                    </Image>
                    <Image x:Name="ImageAboutPcl" Source="/Plain Craft Launcher Slash;component/Images/icon.ico" Grid.Row="3" Width="34" Height="34" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    <local:MyButton x:Name="BtnAboutDonateUpstream" Text="赞助原版 PCL" Grid.Column="2" Grid.Row="0" Height="35" ColorType="Highlight"
                                    local:CustomEventService.EventType="打开网页" local:CustomEventService.EventData="https://meloong.com/afd/a/LTCat" />
                </Grid>
            </local:MyCard>
            <local:MyCard x:Name="CardLegal" Margin="0,0,0,15" Title="法律信息" IsSwapped="True" CanSwap="True">
                <StackPanel Margin="25,39,23,20">
                    <TextBlock Text="项目与开发者" TextWrapping="Wrap" Margin="0,6,0,4" FontWeight="Bold" />
                    <TextBlock Margin="0,0,0,2" LineHeight="17" Text="Plain Craft Launcher Slash（PCL-Slash）是基于 Plain Craft Launcher 的独立分支，由 Lecyn 及贡献者开发。项目仓库为 sparkzure/PCL-Slash；分支相关问题请通过本项目的反馈入口提交。" TextWrapping="Wrap" />
                    <TextBlock Text="原版 PCL 指南" TextWrapping="Wrap" Margin="0,10,0,4" FontWeight="Bold" />
                    <TextBlock Margin="0,0,0,2" LineHeight="17" Text="Copyright © 成都瓜皮龙科技有限公司&#13;本项目遵循原版 PCL 的《PCL 存储库合理使用指南》，指南保留在项目根目录 LICENCE 文件中。" TextWrapping="Wrap" />
                    <TextBlock Text="网络访问" TextWrapping="Wrap" Margin="0,10,0,4" FontWeight="Bold" />
                    <TextBlock Margin="0,0,0,2" LineHeight="17" Text="账号登录、资源下载、更新检查等功能会连接相应的第三方服务，相关数据处理受各服务提供方的规则约束。" TextWrapping="Wrap" />
                    <TextBlock Text="本地数据与隐私" TextWrapping="Wrap" Margin="0,10,0,4" FontWeight="Bold" />
                    <TextBlock Margin="0,0,0,2" LineHeight="17" Text="启动器会在本地保存账号登录信息、设置、缓存与运行日志，以支持相应功能。提交反馈或分享日志前，请先检查其中是否含有账号、文件路径等个人信息。" TextWrapping="Wrap" />
                    <TextBlock Text="非官方产品声明" TextWrapping="Wrap" Margin="0,10,0,4" FontWeight="Bold" />
                    <TextBlock Margin="0,0,0,2" LineHeight="17" Text="非 MINECRAFT 官方产品。未经 MOJANG 或 MICROSOFT 批准，也不与 MOJANG 或 MICROSOFT 关联。Minecraft 及相关商标归其各自权利人所有。" TextWrapping="Wrap" />
                    <WrapPanel HorizontalAlignment="Left" Margin="0,12,0,0">
                        <local:MyButton Text="原版 PCL 用户协议" MinWidth="150" Height="35" Padding="13,0" Margin="0,0,12,8"
                                        local:CustomEventService.EventType="打开网页" local:CustomEventService.EventData="https://shimo.im/docs/rGrd8pY8xWkt6ryW#anchor-RnU9" />
                        <local:MyButton Text="原版 PCL 分发许可" MinWidth="150" Height="35" Padding="13,0" Margin="0,0,12,8"
                                        local:CustomEventService.EventType="打开网页" local:CustomEventService.EventData="https://shimo.im/docs/rGrd8pY8xWkt6ryW#anchor-X0bo" />
                        <local:MyButton Text="项目源码" MinWidth="120" Height="35" Padding="13,0" Margin="0,0,12,8" local:CustomEventService.EventType="打开网页" local:CustomEventService.EventData="{x:Static local:ModBase.SourceRepository}" />
                        <local:MyButton Text="问题反馈" MinWidth="120" Height="35" Padding="13,0" Margin="0,0,0,8" local:CustomEventService.EventType="打开网页" local:CustomEventService.EventData="{x:Static local:ModBase.FeedbackUrl}" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>
