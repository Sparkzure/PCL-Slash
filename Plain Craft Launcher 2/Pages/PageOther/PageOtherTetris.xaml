<local:MyPageRight x:Class="PageOtherTetris"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" Focusable="True">
    <Grid Margin="25,10">
        <local:MyCard x:Name="CardTetris" Title="俄罗斯方块" Margin="0,15">
            <Grid Margin="25,40,25,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,12">
                    <local:MyButton x:Name="BtnTetrisRestart" Text="开始游戏" Height="30" Padding="14,0" Margin="0,0,18,8" />
                    <TextBlock x:Name="LabTetrisScore" VerticalAlignment="Center" Margin="0,0,18,8" Foreground="{DynamicResource ColorBrush1}" />
                    <TextBlock x:Name="LabTetrisStatus" VerticalAlignment="Center" Margin="0,0,0,8" Foreground="{DynamicResource ColorBrush1}" />
                </WrapPanel>
                <Grid Grid.Row="1" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                        <Border Background="{DynamicResource ColorBrushGray8}" BorderBrush="{DynamicResource ColorBrushGray5}" BorderThickness="1" Padding="3" CornerRadius="4">
                            <UniformGrid x:Name="PanTetrisBoard" Columns="10" Rows="20" Width="240" Height="480" AutomationProperties.Name="俄罗斯方块棋盘" />
                        </Border>
                    </Viewbox>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                        <TextBlock Text="下一个" Margin="0,0,0,8" Foreground="{DynamicResource ColorBrushGray2}" />
                        <UniformGrid x:Name="PanTetrisNext" Columns="4" Rows="4" Width="80" Height="80" />
                    </StackPanel>
                </Grid>
            </Grid>
        </local:MyCard>
    </Grid>
</local:MyPageRight>
